# Copy this file to .env and fill in the keys you want to use.
# .env is gitignored and must never be committed.

# ___ 2 Tested Models & 1 Default Provider ___
# | 1st Tested (also default provider): Anthropic (Claude) |
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the default Claude model
# ANTHROPIC_MODEL=claude-sonnet-5

# | 2nd Tested (also fully offline with a local model): Ollama |
# An alternative to Anthropic, not the default. Set USE_OLLAMA=1 to make it the
# default provider, or just pick "ollama" in the Model tab at runtime.
# Requires Ollama installed and the model pulled (e.g. `ollama pull llama3.2`).
# No API key needed; runs locally.
# USE_OLLAMA=1
# OLLAMA_MODEL=llama3.2

# ___ Other Providers: Supported But Not Personally Tested ___
# Only needed if you select them in the Model tab AND
# have installed the matching langchain-* package (e.g. pip install langchain-openai).
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=

# ___ Optional: embedding model override (default is a small, fast local model) ___
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ___ Optional: disabling telemetry ___
# ANONYMIZED_TELEMETRY=false
# CHROMA_TELEMETRY_ENABLED=false
# LANGCHAIN_TRACING_V2=false
# LANGSMITH_TRACING=false
# HF_HUB_DISABLE_TELEMETRY=1
# DO_NOT_TRACK=1